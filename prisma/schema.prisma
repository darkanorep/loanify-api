// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int           @id @default(autoincrement())
  first_name        String
  middle_name       String?
  last_name         String
  email             String        @unique
  phone_number      String?       @unique
  username          String?       @unique
  password          String?
  google_id         String?       @unique
  otp               String?
  otp_expires       DateTime?
  is_verified       Boolean       @default(false)
  reset_otp         String?
  reset_otp_expires DateTime?
  loans             Loan[]
  transactions      Transaction[]
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
}

// Add these to your existing schema.prisma, and add the two relation
// fields noted at the bottom to your existing User model.

enum LoanStatus {
  PENDING // application submitted, awaiting approval
  APPROVED // approved but not yet disbursed
  ACTIVE // disbursed, currently being repaid
  COMPLETED // fully repaid
  REJECTED // application denied
  DEFAULTED // missed payments beyond your grace period
  CANCELLED // withdrawn by borrower before disbursement
}

enum InstallmentStatus {
  PENDING // not yet paid — "overdue" is derived (due_date < now), not stored
  PARTIALLY_PAID
  PAID
}

enum TransactionType {
  DISBURSEMENT
  REPAYMENT
}

model Loan {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  purpose String? // optional — what the loan is for

  // Terms, locked in at creation — see note above on why these aren't
  // recalculated live from interest_rate.
  principal_amount    Decimal @db.Decimal(12, 2)
  interest_rate       Decimal @db.Decimal(5, 2) // flat %, e.g. 5.00 = 5%
  term_months         Int
  monthly_installment Decimal @db.Decimal(12, 2)
  total_repayable     Decimal @db.Decimal(12, 2) // principal + total flat interest

  // Running totals — updated as transactions come in, not recalculated
  // from scratch on every read.
  total_paid          Decimal @default(0) @db.Decimal(12, 2)
  outstanding_balance Decimal @db.Decimal(12, 2)

  status LoanStatus @default(PENDING)

  applied_at   DateTime  @default(now())
  approved_at  DateTime?
  disbursed_at DateTime?
  completed_at DateTime?

  installments Installment[]
  transactions Transaction[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([status])
}

model Installment {
  id      Int  @id @default(autoincrement())
  loan_id Int
  loan    Loan @relation(fields: [loan_id], references: [id])

  installment_number Int // 1, 2, 3... up to term_months
  due_date           DateTime
  amount_due         Decimal           @db.Decimal(12, 2)
  amount_paid        Decimal           @default(0) @db.Decimal(12, 2)
  status             InstallmentStatus @default(PENDING)
  paid_at            DateTime?

  transactions Transaction[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([loan_id, installment_number]) // one #3 per loan, not globally
  @@index([loan_id])
  @@index([due_date])
}

model Transaction {
  id      Int  @id @default(autoincrement())
  loan_id Int
  loan    Loan @relation(fields: [loan_id], references: [id])
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?

  // Optional — set when a repayment transaction is applied against a
  // specific installment. Null for the disbursement transaction itself.
  installment_id Int?
  installment    Installment? @relation(fields: [installment_id], references: [id])

  created_at DateTime @default(now())

  @@index([loan_id])
  @@index([user_id])
}
